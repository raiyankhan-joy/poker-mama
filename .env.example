# ================= SERVER CONFIG =================
PORT=3000
HOST=0.0.0.0
# Set to true when hosted behind HTTPS proxy (Render / Railway / Fly.io / Cloudflare)
FORCE_HTTPS=true

# ================= PERSISTENT LEADERBOARD & STATS =================
# Option 1 (Recommended Free Cloud DB): Upstash Redis (https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Option 2 (Alternative Free Cloud DB): Supabase (table: pooker_state with columns id text primary key, payload jsonb)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Option 3: Mounted Persistent Disk folder (e.g. /var/data on Render Disk / Railway Volume)
DATA_DIR=

# ================= VOICE CHAT TURN SERVER (4G/5G NAT) =================
# Option A (Recommended Free Tier): Metered.ca (https://www.metered.ca/tools/openrelay/)
METERED_APP_NAME=
METERED_API_KEY=

# Option B: Any standard TURN server (Cloudflare Calls, Coturn, Twilio)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
